# =====================================================================
# Secrets — NEVER COMMIT
# =====================================================================
publishing/tokens/
publishing/credentials/
# X クロスポスト失敗 marker (GHA run 内のみの一時ファイル。Report X failure が読む)
x_failure.json
# Meta (FB/IG/Threads) クロスポスト失敗 marker (同上。Report Meta failure が読む)
meta_failure.json
video-use/.env
.env
.env.local
.env.*.local
*.pem
*.key
*_secret*.json
*credentials*.json
!**/youtube_client_secret.example.json

# =====================================================================
# Large source media (distribute separately via Drive/Dropbox)
# =====================================================================
*.MOV
*.mov
*.MP4
*.mp4
*.MTS
*.AVI
*.avi
*.mkv

# Exception: queue で投稿待ちの mp4 は git 管理 (GHA dispatcher が拾うため)
!publishing/queue/**/*.mp4

# =====================================================================
# Episode-specific intermediates (each member regenerates)
# =====================================================================
source-podcast/IMG_*
source-podcast/raw_*
source-podcast/edit/transcripts/
source-podcast/edit/takes_packed.md
source-podcast/edit/master.srt
source-podcast/edit/edl.json
source-podcast/edit/CANDIDATE_POOL.md
source-podcast/edit/shorts/

# Per-clip intermediates inside shorts_v2 (keep dir + compose script)
source-podcast/edit/shorts_v2/*/
!source-podcast/edit/shorts_v2/.gitkeep
source-ep*/

# =====================================================================
# Generated audio (regenerate via batch_generate.py)
# =====================================================================
publishing/audio/bgm/*.mp3
publishing/audio/bgm/*.wav
publishing/audio/sfx/*.mp3
publishing/audio/sfx/*.wav
!publishing/audio/bgm/.gitkeep
!publishing/audio/sfx/.gitkeep

# =====================================================================
# Publishing state & logs
# =====================================================================
# publishing-state は GHA auto-post と post-monitor が共有するため git 管理
# (動画ID/視聴数等を含む。⚠️ repo は PUBLIC — 公開済み投稿のメタデータのみなので可。
#  トークン/エラー詳細など秘匿情報は絶対にここに書かないこと)
publishing/scripts/logs/
!publishing/scripts/logs/.gitkeep

# =====================================================================
# System / Python / IDE
# =====================================================================
.DS_Store
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
*.egg-info/
.idea/
.vscode/
*.swp
*~
